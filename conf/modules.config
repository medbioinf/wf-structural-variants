/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: '.*LONGREAD_ASSEMBLY:SAMTOOLS_FASTQ' {
        publishDir = [ enabled: false ]
    }
    withName: '.*LONGREAD_ASSEMBLY:CAT_FASTQ' {
        publishDir = [ enabled: false ]
    }
    withName: '.*LONGREAD_ASSEMBLY:HIFIASM' {
        publishDir = [ enabled: false ]
    }
    withName: '.*LONGREAD_ASSEMBLY:GFATOOLS_GFA2FA' {
        publishDir = [
            path: { "${params.outdir}/assemblies" },
            mode: 'copy'
        ]
    }
    
    withName: '.*PANGENOME_GRAPH:PANSN_FORMAT' {
        publishDir = [ enabled: false ]
    }
    withName: '.*PANGENOME_GRAPH:PANSN_FORMAT_REF' {
        publishDir = [
            path: { "${params.outdir}/pangenome" },
            mode: params.publish_dir_mode,
        ]
    }
    withName: '.*PANGENOME_GRAPH:SAMTOOLS_FAIDX_REF' {
        publishDir = [ enabled: false ]
    }
    withName: '.*PANGENOME_GRAPH:MINIGRAPH_PANGENOME' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/pangenome" },
            mode: 'copy'
        ]
    }
    withName: '.*PANGENOME_GRAPH:SAMTOOLS_FAIDX' {
        publishDir = [ enabled: false ]
    }
    withName: '.*PANGENOME_GRAPH:PGGB' {
        ext.args = { [
            "-s ${params.pggb_segment_length ?: '10k'}",
            "-p ${params.pggb_identity ?: '98'}",
            "-k ${params.pggb_kmer_length ?: '47'}",
            "-n ${params.pggb_n_haplotypes ?: meta.num_haplotypes}",
        ].join(' ') }
        publishDir = [ enabled: false ]
    }
    withName: '.*PANGENOME_GRAPH:CACTUS_PANGENOME' {
        publishDir = [ enabled: false ]
    }
    withName: '.*PANGENOME_GRAPH:GFATOOLS_GFA2FA' {
        ext.prefix = { "${meta.id}.gfa2fa" }
        publishDir = [ enabled: false ]
    }
    withName: '.*PANGENOME_GRAPH:GUNZIP_FA' {
        publishDir = [
            path: { "${params.outdir}/pangenome" },
            mode: 'copy'
        ]
    }
    withName: '.*PANGENOME_GRAPH:MINIGRAPH_CALL' {
        ext.prefix = { "${meta.id}" }
        publishDir = [ enabled: false ]
    }
    withName: '.*PANGENOME_GRAPH:GUNZIP_GFA' {
        publishDir = [ enabled: false ]
    }
    withName: '.*PANGENOME_GRAPH:GFA_SET_REFERENCE' {
        publishDir = [
            path: { "${params.outdir}/pangenome/" },
            mode: 'copy'
        ]
    }
    withName: '.*PANGENOME_GRAPH:VG_DECONSTRUCT' {
        ext.args = { "-a" }
        ext.prefix = { "${meta.id}.deconstructed" }
        publishDir = [ enabled: false ]
    }

    withName: '.*SWAVE_PREPROCESSING:SWAVE_EXTRACT_ALLELES' {
        ext.args = {
            [
                "--graph_construction_tool ${params.graph_construction_tool}",
                params.force_reverse ? "--force_reverse" : "",
                params.remove_small ? "--remove_small" : "",
                params.min_sv_size ? "--min_sv_size ${params.min_sv_size}" : "",
                params.spec_snarl ? "--spec_snarl ${params.spec_snarl}" : ""
            ].join(' ')
        }
        publishDir = [ enabled: false ]
    }
    withName: '.*SWAVE_PREPROCESSING:BCFTOOLS_VIEW_REF' {
        ext.args = '-G -Oz'
        ext.prefix = { "${meta.sample}" }
        publishDir = [ enabled: false ]
    }
    withName: '.*SWAVE_PREPROCESSING:BCFTOOLS_QUERY_LIST_SAMPLES' {
        ext.args = '-l'
        ext.suffix = 'samples.txt'
        publishDir = [ enabled: false ]
    }
    withName: '.*SWAVE_PREPROCESSING:BCFTOOLS_VIEW_SAMPLES' {
        ext.args = { "-s ${meta.sample} -Oz" }
        ext.prefix = { "${meta.id}" }
        publishDir = [ enabled: false ]
    }
    withName: '.*SWAVE_PREPROCESSING:SWAVE_SPLIT_ALLELES' {
        ext.seq_per_split = params.seq_per_split
        publishDir = [ enabled: false ]
    }
    withName: '.*SWAVE_PREPROCESSING:SWAVE_GENERATE_DOTPLOTS' {
        ext.args = {
            [
                params.max_sv_size ? "--max_sv_size ${params.max_sv_size}" : "",
                params.kmer_size ? "--kmer_size ${params.kmer_size}" : "",
                params.spec_path ? "--spec_path ${params.spec_path}" : "",
                params.save_dotplot_images ? "--save_dotplot_images" : ""
            ].join(' ')
        }
        publishDir = [
            [
                path: { "${params.outdir}/dotplot_imgs/" },
                mode: params.publish_dir_mode,
                pattern: "**.png"
            ]
        ]
    }
    withName: '.*SWAVE_PREPROCESSING:SWAVE_GENERATE_PROJECTIONS' {
        ext.args = {
            [
                params.kmer_size ? "--kmer_size ${params.kmer_size}" : "",
                params.save_projection_images ? "--save_projections_images" : ""
            ].join(' ')
        }
        publishDir = [
            [
                path: { "${params.outdir}/projection_imgs/" },
                mode: params.publish_dir_mode,
                pattern: "**.png"
            ]
        ]
    }

    withName: '.*SWAVE_GENOTYPING:SWAVE_PREDICT' {
        ext.args = {
            [
                params.use_gpu ? "--device gpu" : "--device cpu",
                params.model ? "--model ${params.model}" : ""
            ].join(' ')
        }
        publishDir = [ enabled: false ]
    }
    withName: '.*SWAVE_GENOTYPING:SWAVE_CALL_VARIANTS' {
        ext.args = {
            [
                params.min_sv_size ? "--min_sv_size ${params.min_sv_size}" : "",
                params.max_sv_size ? "--max_sv_size ${params.max_sv_size}" : "",
                params.max_sv_comps ? "--max_sv_comps ${params.max_sv_comps}" : "",
                params.dup_to_ins ? "--dup_to_ins" : ""
            ].join(' ')
        }
        publishDir = [ enabled: false ]
    }
    withName: '.*SWAVE_GENOTYPING:SWAVE_WRITE_VCF' {
        publishDir = [
            [
                path: { "${params.outdir}/variants/raw" },
                mode: 'copy',
                pattern: "*.vcf"
            ]
        ]
    }

    withName: '.*SWAVE_ANNOTATION:ANNOVAR' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/variants/annotated/" },
            mode: 'copy'
        ]
    }
    withName: '.*SWAVE_ANNOTATION:HTSLIB_BGZIPTABIX' {
        publishDir = [ enabled: false ]
    }
    withName: '.*SWAVE_ANNOTATION:BCFTOOLS_FILTER_RARE' {
        ext.args   = { "-i 'INFO/AF < ${params.af_rare}'" }
        ext.prefix = { "${meta.id}.rare" }
        publishDir = [
            path: { "${params.outdir}/variants/annotated/" },
            mode: 'copy',
            pattern: "*.vcf",
        ]
    }
    withName: '.*SWAVE_ANNOTATION:BCFTOOLS_FILTER_INFREQUENT' {
        ext.args   = { "-i 'INFO/AF >= ${params.af_rare} && INFO/AF < ${params.af_frequent}'" }
        ext.prefix = { "${meta.id}.infrequent" }
        publishDir = [
            path: { "${params.outdir}/variants/annotated/" },
            mode: 'copy',
            pattern: "*.vcf",
        ]
    }
    withName: '.*SWAVE_ANNOTATION:BCFTOOLS_FILTER_FREQUENT' {
        ext.args   = { "-i 'INFO/AF >= ${params.af_frequent}'" }
        ext.prefix = { "${meta.id}.frequent" }
        publishDir = [
            path: { "${params.outdir}/variants/annotated/" },
            mode: 'copy',
            pattern: "*.vcf",
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
