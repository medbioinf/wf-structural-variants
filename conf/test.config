/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run medbioinf/pangenomesv -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    withName: '.*' {
        cpus   = 2
        memory = 6.GB
        time   = 1.h
    }

    withName: '.*HIFIASM.*' {
        ext.args = '-f 0'  // deactivate bloom filter for small test dataset to reduce memory
    }
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    input  = "${projectDir}/assets/test_data/samplesheet_test.csv"
    fasta = "${projectDir}/assets/test_data/reference/chm13v2.0_chr1_1.2Mb.fa"
}
