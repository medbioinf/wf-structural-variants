{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/medbioinf/pangenomesv/master/assets/schema_input.json",
    "title": "medbioinf/pangenomesv pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": ["string", "integer"],
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces"
            },
            "haplotype": {
                "type": "integer",
                "enum": [0, 1, 2],
                "errorMessage": "Haplotype must be either 0 (unphased), 1 (paternal) or 2 (maternal)"
            },
            "fasta": {
                "type": "string",
                "pattern": "^\\S+\\.(fasta|fa|fna)(\\.gz)?$",
                "errorMessage": "FASTA file must be provided, cannot contain spaces and must be a valid fasta file (.fa, .fasta, .fna)"
            },
            "bam_dir": {
                "type": "string",
                "errorMessage": "BAM directory path must be provided as a string"
            }
        },
        "required": ["sample"],
        "anyOf": [
            { "required": ["fasta", "haplotype"] },
            { "required": ["bam_dir"] }
        ]
    }
}
