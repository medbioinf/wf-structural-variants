{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/medbioinf/wf-structural-variants/master/assets/schema_input.json",
    "title": "medbioinf/wf-structural-variants pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces"
            },
            "haplotype": {
                "type": "integer",
                "enum": [1, 2],
                "errorMessage": "Haplotype must be either 1 (paternal) or 2 (maternal)"
            },
            "fasta": {
                "type": "string",
                "format": "file-path",
                "pattern": "^\\S+\\.(fasta|fa|fna)(\\.gz)?$",
                "errorMessage": "FASTA file must be provided, cannot contain spaces and must be a valid fasta file (.fa, .fasta, .fna)"
            }
        },
        "required": ["sample", "haplotype", "fasta"]
    }
}