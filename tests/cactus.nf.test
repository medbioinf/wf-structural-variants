nextflow_pipeline {

    name "Test Pipeline: Cactus"
    script "main.nf"
    profile "test"
    tag "cactus"

    test("run pipeline with cactus") {
        when {
            params {
                outdir = "$outputDir"
                graph_construction_tool = 'cactus'
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert path("${params.outdir}/multiqc/multiqc_report.html").exists() },
                { assert snapshot(
                    path("${params.outdir}/variants/raw").list()
                ).match("variants_raw_filelist") },
                { assert snapshot(path("${params.outdir}/pipeline_info/pangenomesv_software_mqc_versions.yml")).match("software_versions") }
            )
        }
    }
}