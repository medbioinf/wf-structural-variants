nextflow_process {

    name "Test Process ANNOVAR"
    script "../main.nf"
    process "ANNOVAR"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "annovar"

    // NOTE: only a stub test possible, since ANNOVAR's databases require individual, registration-based download

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    file("${projectDir}/modules/local/annovar/tests/test.vcf", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/modules/local/annovar/tests/dummy_annovar_dir", checkIfExists: true)
                input[2] = "hg38"
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }
}