nextflow_process {

    name "Test Process PANSN_FORMAT"
    script "../main.nf"
    process "PANSN_FORMAT"

    tag "modules"
    tag "modules_local"
    tag "pansn_format"

    test("simple sample") {
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', sample:'test_sample', haplotype:'1' ],
                    file("${projectDir}/modules/local/pansn_format/tests/sample.fa", checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', sample:'test_sample', haplotype:'1' ],
                    file("${projectDir}/modules/local/pansn_format/tests/sample.fa", checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }
}