nextflow_process {

    name "Test Process MINIGRAPH_PANGENOME"
    script "../main.nf"
    process "MINIGRAPH_PANGENOME"

    tag "modules"
    tag "modules_local"
    tag "minigraph"
    tag "minigraph_pangenome"

    test("sarscov2 - fasta") {
        
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ])
                input[1] = Channel.of(
                    file("${projectDir}/modules/local/minigraph/pangenome/tests/sample.fa", checkIfExists: true)
                ).collect()
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.gfa,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("sarscov2 - fasta - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ])
                input[1] = Channel.of(
                    file("${projectDir}/modules/local/minigraph/pangenome/tests/sample.fa", checkIfExists: true)
                ).collect()
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }
}