nextflow_process {

    name "Test Process SWAVE_WRITE_VCF"
    script "../main.nf"
    process "SWAVE_WRITE_VCF"
    config "../../extract_alleles/tests/nextflow_minigraph.config"

    tag "modules"
    tag "modules_local"
    tag "swave"
    tag "swave_write_vcf"

    setup {
        run("SWAVE_EXTRACT_ALLELES") {
            script "../../extract_alleles/main.nf"
            process {
                """
                input[0] = Channel.of([
                    [ id:'HG002_hap1', sample:'HG002' ],
                    false,
                    file("${projectDir}/modules/local/swave/extract_alleles/tests/sample.bed", checkIfExists: true),
                    []
                ])
                input[1] = file("${projectDir}/modules/local/swave/extract_alleles/tests/ref_minigraph.bed", checkIfExists: true)
                input[2] = file("${projectDir}/modules/local/swave/extract_alleles/tests/minigraph_gfa_fasta.fa", checkIfExists: true)
                """
            }
        }
        run("SWAVE_GENERATE_DOTPLOTS") {
            script "../../generate_dotplots/main.nf"
            process {
                """
                input[0] = SWAVE_EXTRACT_ALLELES.out.fa
                    .map { meta, fa_files ->
                        def fa = fa_files instanceof List ? fa_files[0] : fa_files
                        [ meta, fa ]
                    }
                input[1] = file("${projectDir}/modules/local/swave/generate_dotplots/tests/ref.fa", checkIfExists: true)
                input[2] = file("${projectDir}/modules/local/swave/extract_alleles/tests/minigraph_gfa_fasta.fa", checkIfExists: true)
                """
            }
        }
        run("SWAVE_GENERATE_PROJECTIONS") {
            script "../../generate_projections/main.nf"
            process {
                """
                input[0] = SWAVE_GENERATE_DOTPLOTS.out.dotplots
                """
            }
        }
        run("SWAVE_PREDICT") {
            script "../../predict/main.nf"
            process {
                """
                input[0] = SWAVE_GENERATE_PROJECTIONS.out.projections
                """
            }
        }
        run("SWAVE_CALL_VARIANTS") {
            script "../../call_variants/main.nf"
            process {
                """
                input[0] = SWAVE_PREDICT.out.predictions
                    .join(SWAVE_GENERATE_PROJECTIONS.out.projections)
                    .join(SWAVE_GENERATE_DOTPLOTS.out.dotplots)
                """
            }
        }
    }

    test("tsv files") {
        when {
            process {
                """
                input[0] = SWAVE_CALL_VARIANTS.out.tsv
                    .map { _meta, tsv -> tsv }
                    .collect()
                    .map { tsv_list -> [ [ id:'pangenomesv' ], tsv_list ] }
                input[1] = file("${projectDir}/modules/local/swave/generate_dotplots/tests/ref.fa", checkIfExists: true)
                input[2] = []
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.vcf,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("tsv files - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = SWAVE_CALL_VARIANTS.out.tsv
                    .map { _meta, tsv -> tsv }
                    .collect()
                    .map { tsv_list -> [ [ id:'pangenomesv' ], tsv_list ] }
                input[1] = file("${projectDir}/modules/local/swave/generate_dotplots/tests/ref.fa", checkIfExists: true)
                input[2] = []
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }
}