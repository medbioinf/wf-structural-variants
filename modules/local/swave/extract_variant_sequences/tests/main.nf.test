nextflow_process {

    name "Test Process SWAVE_EXTRACT_VARIANT_SEQUENCES"
    script "../main.nf"
    process "SWAVE_EXTRACT_VARIANT_SEQUENCES"

    tag "modules"
    tag "modules_local"
    tag "swave"
    tag "swave_extract_variant_sequences"

    test("extract sequences from vcf") {
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'pangenomesv' ],
                    file("${projectDir}/modules/local/swave/extract_variant_sequences/tests/sample.vcf", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/modules/local/swave/extract_variant_sequences/tests/gfa_fasta.fa", checkIfExists: true)
                """
            }
        }
        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("extract sequences from vcf - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'pangenomesv' ],
                    file("${projectDir}/modules/local/swave/extract_variant_sequences/tests/sample.vcf", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/modules/local/swave/extract_variant_sequences/tests/gfa_fasta.fa", checkIfExists: true)
                """
            }
        }
        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }
}