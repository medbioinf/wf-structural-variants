nextflow_process {

    name "Test Process SWAVE_ANNOTATE_VCF_WITH_TRF"
    script "../main.nf"
    process "SWAVE_ANNOTATE_VCF_WITH_TRF"

    tag "modules"
    tag "modules_local"
    tag "swave"
    tag "swave_annotate_vcf_with_trf"

    test("annotate vcf with trf repeat ratios") {
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'pangenomesv' ],
                    file("${projectDir}/modules/local/swave/annotate_vcf_with_trf/tests/sample.vcf", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/modules/local/swave/annotate_vcf_with_trf/tests/sample.dat", checkIfExists: true)
                input[2] = file("${projectDir}/modules/local/swave/annotate_vcf_with_trf/tests/sample.fa", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.vcf,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("annotate vcf with trf repeat ratios - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'pangenomesv' ],
                    file("${projectDir}/modules/local/swave/annotate_vcf_with_trf/tests/sample.vcf", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/modules/local/swave/annotate_vcf_with_trf/tests/sample.dat", checkIfExists: true)
                input[2] = file("${projectDir}/modules/local/swave/annotate_vcf_with_trf/tests/sample.fa", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }
}