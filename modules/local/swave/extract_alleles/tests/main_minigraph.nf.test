nextflow_process {

    name "Test Process SWAVE_EXTRACT_ALLELES - minigraph"
    script "../main.nf"
    process "SWAVE_EXTRACT_ALLELES"
    config "./nextflow_minigraph.config"

    tag "modules"
    tag "modules_local"
    tag "swave"
    tag "swave_extract_alleles"

    test("minigraph - sample bed input") {
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'HG002_hap1' ],
                    false,
                    file("${projectDir}/modules/local/swave/extract_alleles/tests/sample.bed", checkIfExists: true),
                    []
                ])
                input[1] = file("${projectDir}/modules/local/swave/extract_alleles/tests/ref_minigraph.bed", checkIfExists: true)
                input[2] = file("${projectDir}/modules/local/swave/extract_alleles/tests/minigraph_gfa_fasta.fa", checkIfExists: true)
                """
            }
        }
        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("minigraph - reference bed input") {
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'mini_chm13v2_0' ],
                    true,
                    file("${projectDir}/modules/local/swave/extract_alleles/tests/ref_minigraph.bed", checkIfExists: true),
                    []
                ])
                input[1] = []
                input[2] = file("${projectDir}/modules/local/swave/extract_alleles/tests/minigraph_gfa_fasta.fa", checkIfExists: true)
                """
            }
        }
        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("minigraph - bed input - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'HG002_hap1' ],
                    false,
                    file("${projectDir}/modules/local/swave/extract_alleles/tests/sample.bed", checkIfExists: true),
                    []
                ])
                input[1] = file("${projectDir}/modules/local/swave/extract_alleles/tests/ref_minigraph.bed", checkIfExists: true)
                input[2] = file("${projectDir}/modules/local/swave/extract_alleles/tests/minigraph_gfa_fasta.fa", checkIfExists: true)
                """
            }
        }
        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }
}