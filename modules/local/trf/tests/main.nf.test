nextflow_process {

    name "Test Process TRF"
    script "../main.nf"
    process "TRF"

    tag "modules"
    tag "modules_local"
    tag "trf"

    test("repetitive sequences") {
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    file("${projectDir}/modules/local/trf/tests/sample.fa", checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.dat,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("repetitive sequences - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    file("${projectDir}/modules/local/trf/tests/sample.fa", checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }
}